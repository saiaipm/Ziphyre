# Ziphyre — environment
# Copy to .env.local and fill in. Nothing here is committed.
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │ AI PROVIDER API KEYS DO NOT GO IN THIS FILE.                        │
# │                                                                     │
# │ Ziphyre is bring-your-own-key (FR-81). Each organization enters     │
# │ its own key in the app — Settings → Screening — where it is         │
# │ encrypted and stored per organization in the database.              │
# │                                                                     │
# │ Ziphyre never ships with a provider key, and one customer's key     │
# │ is never readable by another. The only key-related value here is    │
# │ SETTINGS_ENCRYPTION_KEY below, which does the encrypting.           │
# └─────────────────────────────────────────────────────────────────────┘

# --- Supabase -------------------------------------------------------------
# Create a project at supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Enable: Google Drive API, Google Sheets API, Google Forms API
# Scopes are read-only by design (tech spec §5.1)
#
# NOTE: this is for SIGN-IN and reading the admin's Forms/Sheets/Drive.
# It is NOT the Gemini API key — that one goes in the app UI, see above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Organization bootstrap ----------------------------------------------
# The one address that creates the organization on first sign-in.
# Everyone else is refused until invited (tech spec §3.1).
SEED_ADMIN_EMAIL=

# --- Job runner -----------------------------------------------------------
# Shared secret guarding the cron routes. Any random string:
#   openssl rand -hex 32
CRON_SECRET=

# --- Settings encryption ---------------------------------------------------
# Infrastructure, not a provider credential. This is the AES-256-GCM key
# that encrypts each organization's provider API key at rest in the
# database (TechDecisions §8).
#
#   Generate with:  openssl rand -base64 32
#
# Lose this and every stored provider key becomes permanently unreadable.
# Back it up like a database credential. Rotating it means re-encrypting
# every stored key.
SETTINGS_ENCRYPTION_KEY=
