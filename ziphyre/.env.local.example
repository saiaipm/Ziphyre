# Ziphyre — environment
# Copy to .env.local and fill in. Nothing here is committed.

# --- Supabase -------------------------------------------------------------
# Create a project at supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Enable: Google Drive API, Google Sheets API, Google Forms API
# Scopes are read-only by design (tech spec §5.1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Organization bootstrap ----------------------------------------------
# The one address that creates the organization on first sign-in.
# Everyone else is refused until invited (tech spec §3.1).
SEED_ADMIN_EMAIL=

# --- Job runner -----------------------------------------------------------
# Shared secret guarding the cron routes.
CRON_SECRET=
